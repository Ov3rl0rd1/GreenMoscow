<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — GreenMoscow</title>
    <script>
        (() => {
            try {
                const theme = localStorage.getItem("greenplan-theme");
                if (theme === "dark" || theme === "light") {
                    document.documentElement.dataset.theme = theme;
                }
            } catch {
            }
        })();
    </script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <a class="brand" asp-page="/Index">
            <svg class="brand-mark" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 21V11" />
                <path d="M12 12c0-4 2.5-7 7-7 0 4.5-3 7-7 7Z" />
                <path d="M12 15c0-3-2-5.5-6-5.5 0 3.5 2.5 5.5 6 5.5Z" />
                <path d="M4 21h16" class="brand-ground" />
            </svg>
            <span>GreenMoscow</span>
        </a>
        <span class="tagline">озеленение с учётом подземных сетей</span>
        <button type="button" class="theme-toggle" data-theme-toggle aria-label="Сменить тему оформления" title="Сменить тему">
            <svg viewBox="0 0 24 24" aria-hidden="true" class="icon-moon"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z" /></svg>
            <svg viewBox="0 0 24 24" aria-hidden="true" class="icon-sun"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
        </button>
    </header>
    <main class="page">
        @RenderBody()
    </main>
    <footer class="footer">
        Посадки ложатся на отдельные слои DXF, исходные слои чертежа не меняются.
        Каждая посадка и каждый отказ объяснены со ссылкой на норму.
    </footer>
    <script>
        (() => {
            const button = document.querySelector("[data-theme-toggle]");
            if (!button) {
                return;
            }
            const current = () => document.documentElement.dataset.theme
                || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
            button.addEventListener("click", () => {
                const next = current() === "dark" ? "light" : "dark";
                document.documentElement.dataset.theme = next;
                try {
                    localStorage.setItem("greenplan-theme", next);
                } catch {
                }
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
