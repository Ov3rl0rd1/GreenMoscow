@page "{id}"
@model GreenPlan.Web.Pages.Jobs.DetailsModel
@{
    var job = Model.Job!;
    var summary = new JobSummaryView(job.Summary);
    ViewData["Title"] = job.Title;
    var finished = JobStatusText.IsFinished(job.Status);
    var timeline = Model.Timeline!;
}

<section class="card">
    <p><a asp-page="/Index">← Новый расчёт</a></p>
    <h1>@job.Title</h1>
    <div data-status-url="@JobStatusEndpoints.UrlFor(job.JobId)">
        <p>Статус: <span class="status status-@job.Status" data-status-text>@JobStatusText.For(job.Status)</span></p>
        @if (!finished)
        {
            <p class="lead"><span data-progress-text>@JobProgressText.For(job)</span> Страница покажет итог сама, как только расчёт завершится.</p>
            <p class="lead" data-connection-text hidden>Нет связи с сервисом расчёта, повторим попытку чуть позже.</p>
        }
        <h2>Ход расчёта</h2>
        <table class="summary stages">
            <tbody>
                @foreach (var stage in timeline.Stages)
                {
                    <tr class="stage stage-@stage.State" data-stage="@stage.Key" data-state="@stage.State" data-seconds="@stage.Seconds?.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                        <th>@stage.Title</th>
                        <td data-stage-time>@stage.TimeText</td>
                    </tr>
                }
                <tr class="stage-total" data-seconds="@timeline.ElapsedSeconds?.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                    <th>Всего</th>
                    <td data-elapsed>@timeline.ElapsedText</td>
                </tr>
            </tbody>
        </table>
    </div>
    <p>Загружено: @job.UploadName; главный чертёж: <code>@job.MainFile</code></p>
    @if (job.OverlayFiles is { Count: > 0 })
    {
        <p>Наложены в тех же координатах: @string.Join(", ", job.OverlayFiles)</p>
    }
    <p>Создан: @job.CreatedAt; обновлён: @job.UpdatedAt</p>
    @if (job.Error is not null)
    {
        <pre class="alert">@job.Error</pre>
    }
</section>

@if (!finished)
{
    @section Scripts {
        <script src="~/js/job-status.js" asp-append-version="true"></script>
    }
}

@if (job.Status == JobStatuses.Succeeded)
{
    <section class="card">
        <h2>Итог</h2>
        <table class="summary">
            <tbody>
                <tr><th>Размещение</th><td>@GuidanceText.For(summary.Text("guidance"))</td></tr>
                @if (summary.CompositionText() is { } composition)
                {
                    <tr><th>Композиция</th><td>@composition</td></tr>
                }
                @if (summary.BenefitText() is { } benefit)
                {
                    <tr><th>Польза</th><td>@benefit</td></tr>
                }
                <tr><th>Деревьев</th><td>@summary.Integer("trees")</td></tr>
                <tr><th>Кустарников</th><td>@summary.Integer("shrubs")</td></tr>
                <tr><th>Условно допустимых посадок</th><td>@summary.Integer("conditional")</td></tr>
                <tr><th>Отказов с объяснением</th><td>@summary.Integer("rejected")</td></tr>
                <tr>
                    <th>Независимая проверка</th>
                    <td>@(summary.Flag("verification_valid") == true ? "пройдена" : "не пройдена"), нарушений: @summary.Integer("violations")</td>
                </tr>
                <tr>
                    <th>Исходный чертёж</th>
                    <td>@(summary.Flag("integrity_is_intact") == true ? "не изменён" : "изменён")</td>
                </tr>
            </tbody>
        </table>

        @if (summary.Warnings().Count > 0)
        {
            <h3>На что обратить внимание</h3>
            <ul class="warnings">
                @foreach (var warning in summary.Warnings())
                {
                    <li>@warning</li>
                }
            </ul>
        }
    </section>

    @if (job.Artifacts.Contains("preview.png"))
    {
        <section class="card">
            <h2>Превью</h2>
            <img class="preview" src="@ArtifactEndpoints.UrlFor(job.JobId, "preview.png")" alt="Превью плана посадок" />
        </section>
    }

    <section class="card">
        <h2>Файлы результата</h2>
        <ul class="artifacts">
            @foreach (var artifact in job.Artifacts)
            {
                <li><a href="@ArtifactEndpoints.UrlFor(job.JobId, artifact)">@artifact</a></li>
            }
        </ul>
    </section>
}
