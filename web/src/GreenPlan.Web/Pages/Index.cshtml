@page
@model IndexModel
@{
    ViewData["Title"] = "Новый расчёт";
}

<section class="card">
    <h1>Новый расчёт</h1>
    <p class="lead">
        Загрузите главный чертёж объекта или архив его папки вместе с внешними ссылками.
        Результат — DXF с посадками на отдельных слоях, отчёты с объяснениями и независимая проверка.
    </p>

    @if (!Model.EngineAvailable)
    {
        <p class="alert">Сервис расчёта сейчас недоступен. Проверьте, что запущен контейнер engine.</p>
    }

    @if (Model.ErrorMessage is not null)
    {
        <p class="alert">@Model.ErrorMessage</p>
    }

    <form method="post" enctype="multipart/form-data" class="upload">
        <div asp-validation-summary="ModelOnly" class="alert-list"></div>

        <label asp-for="Form.Drawing"></label>
        <input asp-for="Form.Drawing" type="file" accept=".dxf,.dwg,.zip" multiple />
        <span asp-validation-for="Form.Drawing" class="field-error"></span>

        <label asp-for="Form.Title"></label>
        <input asp-for="Form.Title" />
        <span asp-validation-for="Form.Title" class="field-error"></span>

        <label asp-for="Form.Territory"></label>
        <select asp-for="Form.Territory">
            <option value="">по умолчанию — улица районного значения</option>
            @foreach (var territory in Model.Territories)
            {
                <option value="@territory.Id">@territory.NameRu — @territory.CompositionRu</option>
            }
        </select>

        <label asp-for="Form.MainFile"></label>
        <input asp-for="Form.MainFile" placeholder="Генплан.dxf" />

        @if (Model.ModelAvailable)
        {
            <label class="checkbox"><input asp-for="Form.UseModel" /> @Html.DisplayNameFor(model => model.Form.UseModel)</label>
            <div class="option-with-help">
                <label class="checkbox"><input asp-for="Form.ExceedDensity" /> @Html.DisplayNameFor(model => model.Form.ExceedDensity)</label>
                <details class="help">
                    <summary title="Что это даёт и чем грозит">?</summary>
                    <div class="help-text">
                        <p>Норматив плотности ТСН 30-307 (табл. В.1) рекомендательный: на 1 км улицы 150–180 деревьев и 600–720 кустарников. Проектировщики в решениях датасета часто сажают кустарник куртинами гуще норматива — на Харьковской улице около 8 тыс. кустов при нормативе 529.</p>
                        <p><strong>Что даст:</strong> количество посадок задаёт модель по проектной практике, куртины и живые изгороди получаются крупнее и ближе к проектным решениям; норматив только сообщается в отчёте.</p>
                        <p><strong>Последствия:</strong> план превышает рекомендательный норматив — превышение придётся обосновать при согласовании; растут стоимость посадки и ухода; обязательные нормы (отступы от сетей, зданий, охранные требования) проверяются как обычно и не нарушаются.</p>
                    </div>
                </details>
            </div>
        }
        else
        {
            <input type="hidden" name="Form.UseModel" value="false" />
        }

        <label asp-for="Form.Config"></label>
        <input asp-for="Form.Config" type="file" accept=".yaml,.yml" />

        <button type="submit">Рассчитать</button>
    </form>
</section>

<section class="card">
    <h2>Последние расчёты</h2>
    @if (Model.Jobs.Count == 0)
    {
        <p>Расчётов пока нет.</p>
    }
    else
    {
        <table class="jobs">
            <thead>
                <tr>
                    <th>Участок</th>
                    <th>Файл</th>
                    <th>Статус</th>
                    <th>Создан</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var job in Model.Jobs)
                {
                    <tr>
                        <td><a asp-page="/Jobs/Details" asp-route-id="@job.JobId">@job.Title</a></td>
                        <td>@job.UploadName</td>
                        <td><span class="status status-@job.Status">@JobStatusText.For(job.Status)</span></td>
                        <td>@job.CreatedAt</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>
